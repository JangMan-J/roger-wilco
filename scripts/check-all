#!/usr/bin/env bash
# The core gate, then the seal guard, which passes quietly where no seal exists.
# Usage: scripts/check-all
set -euo pipefail
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then echo "usage: $0 (run the core gate and the seal guard)"; exit 0; fi
[[ $# == 0 ]] || { echo "usage: $0" >&2; exit 2; }
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

echo "== scripts/check"
scripts/check
echo "== scripts/check-seal"
scripts/check-seal
echo "PASS check-all"
