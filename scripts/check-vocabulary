#!/usr/bin/env bash
# Invariant check: the core never speaks of what a session is doing with its Mail.
# No turn, wake, idle, or busy state or request exists in the core, its wire, or its
# documents, so the same core serves a call center and an agent team. What a consumer
# does when Mail arrives is the consumer's.
#
# The core is every file in the checkout (tracked or untracked, minus .gitignore)
# outside VECTORS/ and docs/reviews/, as for scripts/check-harness-free.
# Exempt:
#   frontmatter         a leading YAML block in a markdown file
#   .slice/, KERNEL.md, INVARIANTS.md, GLOSSARY.md  the generated scoped set of a slice worktree
#   VECTORS/            the record of what was tried
#   docs/reviews/       historical review evidence
#   AGENTS.md           the director's file; it quotes dated directives verbatim
#   scripts/check-vocabulary  this list of words
#   a line carrying `legacy-wire:` and a reason, for the old wire field that a
#                       reader of logs written before `kind` still needs
#
# The same files may not use the retired terms `shim`, `shims`, or `agent session(s)`:
# session and client are the words.
#
# Usage: scripts/check-vocabulary [path ...]   (default: the whole core)
set -euo pipefail
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then echo "usage: $0 [path ...] (default: whole core)"; exit 0; fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Whole words: "return" and "returns" are not "turn".
WORDS='wake|wakes|woke|woken|waking|turn|turns|idle|busy'
# Retired terms, whole words; the phrase may be split by any whitespace and any case.
RETIRED='shims?|agent[[:space:]]+sessions?'

# A checkout lists its files through git; a plain export (no .git) lists the tree minus target/.
list_files() {
  if git rev-parse --git-dir >/dev/null 2>&1; then
    git ls-files --cached --others --exclude-standard -- "$@"
  else
    find "$@" -type f -not -path '*/target/*' -not -path '*/.git/*' | sed 's#^\./##'
  fi
}
mapfile -t files < <(list_files "${@:-.}" |
  grep -vE '^(VECTORS|\.slice)/|^(KERNEL|INVARIANTS|GLOSSARY)\.md$|^docs/reviews/|^AGENTS\.md$|^scripts/check-vocabulary$' | sort -u |
  while IFS= read -r f; do [[ -f "$f" ]] && printf '%s\n' "$f"; done)
((${#files[@]})) || { echo "FAIL: no core files under ${*:-.}" >&2; exit 1; }

# scan <regex>: every line of every core file that matches, frontmatter blanked.
scan() {
  local f
  for f in "${files[@]}"; do
    if [[ "$f" == *.md ]]; then
      awk 'NR == 1 && /^---[[:space:]]*$/ { fm = 1 }
           fm { buf[++n] = $0; if (NR > 1 && /^---[[:space:]]*$/) { for (i = 1; i <= n; i++) print ""; fm = n = 0 }; next }
           { print }
           END { for (i = 1; i <= n; i++) print buf[i] }' "$f" |
        grep -HniIE --label="$f" "\b($1)\b" || true
    else
      grep -HniIE "\b($1)\b" -- "$f" || true
    fi
  done
}

hits="$(scan "$WORDS" | grep -v 'legacy-wire:' || true)"
if [[ -n "$hits" ]]; then
  echo "FAIL: turn, wake, idle, or busy vocabulary in the core:" >&2
  echo "$hits" >&2
  exit 1
fi
hits="$(scan "$RETIRED")"
if [[ -n "$hits" ]]; then
  echo "FAIL: retired terms: session and client are the words:" >&2
  echo "$hits" >&2
  exit 1
fi
echo "PASS vocabulary: no turn, wake, idle, busy, or retired vocabulary in ${#files[@]} core files under ${*:-.}"
