#!/usr/bin/env bash
# Acceptance checks named by the project's proofs (README.md, Checks).
# Usage: scripts/acceptance <cross-host|no-poll|independence|claims|references|broadcast|headers|mcp>
set -euo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/acceptance-lib"
CLAUDE="33333333-3333-4333-8333-333333333333"

# Start a detached process on the remote host and record its pid.
remote_spawn() { # remote_spawn <pid-file-name> <stdout-file> <args...>
  local pid_name="$1" out="$2"; shift 2
  local args="$*"
  ssh -n "$REMOTE_HOST" "bash -lc 'cd $remote_work; ($args >$out 2>&1 </dev/null & echo \$! > $pid_name) ; exit 0'"
}

# Two-host core shared by the cross-host checks: build, then a coordinator on
# ROGER_ACCEPT_BIND IPv4 address, a host daemon here ($work/a.sock)
# and one on $REMOTE_HOST ($remote_work/b.sock). Each daemon's
# Host id is its machine's own `hostname`, as scripts/deploy sets it; the ssh
# alias in $REMOTE_HOST names the route, not the host. Sets globals bin, work,
# remote_work, coord, local_host_id, remote_host_id.
two_host_stack() {
  [[ -n "$REMOTE_HOST" ]] || fail "set ROGER_REMOTE_HOST to the remote SSH destination"
  [[ "$REMOTE_HOST" =~ ^[A-Za-z0-9_][A-Za-z0-9_.@:-]*$ ]] || fail "invalid ROGER_REMOTE_HOST"
  local ts_ip="${ROGER_ACCEPT_BIND:-}"
  [[ "$ts_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "set ROGER_ACCEPT_BIND to this host's IPv4 address reachable from the remote host"

  (cd "$ROOT" && cargo build --release --offline -q --features test-hooks) || fail "cargo build"
  bin="$ROOT/target/release/roger"

  local token
  work="$(mktemp -d /tmp/roger-accept.XXXXXX)"
  remote_work="/tmp/roger-accept.$$"
  local_host_id="$(hostname)"
  remote_host_id="$(ssh -n -o ConnectTimeout=5 "$REMOTE_HOST" hostname)" || fail "ssh hostname on $REMOTE_HOST"
  [[ "$local_host_id" =~ ^[A-Za-z0-9._-]+$ && "$remote_host_id" =~ ^[A-Za-z0-9._-]+$ ]] || fail "hostname is not a safe host id"
  token="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  export ROGER_TOKEN="$token" # the core reads it from the environment, never argv

  trap cleanup EXIT

  "$bin" coordinator --bind "$ts_ip:0" --port-file "$work/port" \
    --data "$work/coord.log" >"$work/coord.out" 2>&1 &
  coord_pid=$!
  wait_for 10 "coordinator port file" test -s "$work/port"
  coord="$ts_ip:$(cat "$work/port")"

  "$bin" daemon --coordinator "$coord" \
    --host-id "$local_host_id" --socket "$work/a.sock" --data "$work/a.log" \
    >"$work/daemon-a.out" 2>&1 &
  daemon_pid=$!
  wait_for 10 "local daemon socket" test -S "$work/a.sock"

  # Clear it first: a directory left by an earlier run that died before its
  # EXIT trap could satisfy the waits below with nothing running.
  ssh -n -o ConnectTimeout=5 "$REMOTE_HOST" "bash -lc 'rm -rf $remote_work; mkdir -p $remote_work; exit 0'" \
    || fail "ssh mkdir on $REMOTE_HOST"
  scp -q "$bin" "$REMOTE_HOST:$remote_work/roger" || fail "scp binary"

  remote_spawn daemon.pid daemon.out \
    "ROGER_TOKEN=$token ./roger daemon --coordinator $coord --host-id $remote_host_id --socket $remote_work/b.sock --data $remote_work/b.log" \
    || fail "start remote daemon"
  wait_for 15 "remote daemon socket" ssh -n "$REMOTE_HOST" "test -S $remote_work/b.sock"
}

cross_host() {
  two_host_stack

  remote_spawn recipient.pid recipient1.out \
    "./roger session --socket $remote_work/b.sock --id $RECIPIENT --store $remote_work/recipient.store --hold-before-ack $remote_work/held.marker" \
    || fail "start remote recipient"
  wait_for 15 "recipient READY" ssh -n "$REMOTE_HOST" "grep -q READY $remote_work/recipient1.out"

  local body="cross-host proof [[153:Meteor Shower:7]] exactly once"
  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to "$RECIPIENT" \
    --mail accept-1 --body "$body" | grep -q "ACCEPTED mail=accept-1" || fail "send not accepted"

  # held.marker appears only after the body is fsynced to the recipient's
  # Store and before the ack leaves. Kill in that window.
  wait_for 15 "recipient stored and holding before ack" \
    ssh -n "$REMOTE_HOST" "test -f $remote_work/held.marker"
  # No `exit 0` here: the remote status must be the kill's, so a pid that no
  # longer exists fails this check instead of passing silently.
  ssh -n "$REMOTE_HOST" "bash -lc 'kill -9 \$(cat $remote_work/recipient.pid)'" \
    || fail "SIGKILL recipient"

  if grep -q '"ev":"receipt"' "$work/coord.log"; then
    fail "receipt exists before the recipient acked"
  fi

  remote_spawn recipient.pid recipient2.out \
    "./roger session --socket $remote_work/b.sock --id $RECIPIENT --store $remote_work/recipient.store --hold-before-ack $remote_work/held.marker" \
    || fail "restart remote recipient"
  wait_for 15 "DELIVERED after restart" \
    ssh -n "$REMOTE_HOST" "grep -q 'DELIVERED mail=accept-1 record=r-1' $remote_work/recipient2.out"

  local store_lines
  store_lines="$(ssh -n "$REMOTE_HOST" "wc -l < $remote_work/recipient.store" | tr -d ' ')"
  [[ "$store_lines" == "1" ]] || fail "recipient Store must hold the body exactly once, found $store_lines lines"
  ssh -n "$REMOTE_HOST" "grep -qF '$body' $remote_work/recipient.store" \
    || fail "body not byte-identical in recipient Store"

  [[ "$(grep -c '"ev":"mail","mail":"accept-1"' "$work/coord.log")" == "1" ]] \
    || fail "coordinator holds a duplicate mail row"
  [[ "$(grep -c '"ev":"receipt","mail":"accept-1"' "$work/coord.log")" == "1" ]] \
    || fail "coordinator receipt missing or duplicated"
  grep -q '"record":"r-1"' "$work/coord.log" || fail "receipt does not name Store record r-1"

  # Both stamps are on the coordinator's clock; the latency spans the kill.
  local rcpt re
  rcpt="$("$bin" receipt --socket "$work/a.sock" --mail accept-1)" || fail "roger receipt accept-1"
  re="^RECEIPT mail=accept-1 to=$RECIPIENT record=r-1 accepted_at_ms=[0-9]+ receipted_at_ms=[0-9]+ latency_ms=[0-9]+ kind=directed\$"
  [[ "$rcpt" =~ $re ]] || fail "receipt lacks a stamp: $rcpt"

  echo "PASS cross-host: mail survived recipient SIGKILL between Store write and ack, delivered exactly once, receipt names r-1 ($rcpt)"
}

# Proof 2 (K2). One coordinator, two host daemons, one `roger` binary. A real
# program from outside the project, Claude Code (`claude -p`) with the built-in
# `roger mcp` face registered as its only MCP server, runs on host-b; the Tracer,
# a session on another face with no harness, runs on host-a. They exchange Mail
# both ways. This makes ONE REAL model call (haiku, the user's subscription): the
# model must call roger_inbox and roger_send. The evidence is the structure of
# Claude's own stream-json: the tool_result paired by tool_use_id with the
# roger_inbox call, and the roger_send call's input. Loopback only.
independence() {
  command -v claude >/dev/null || fail "claude CLI required for the Claude Code session"
  command -v jq >/dev/null || fail "jq required to read Claude's stream-json"
  local tracer_addr="$RECIPIENT" claude_addr="$CLAUDE"
  loopback_stack
  "$bin" session --socket "$work/a.sock" --id "$tracer_addr" --store "$work/tracer.store" \
    >"$work/tracer.out" 2>&1 &
  pids+=("$!")
  wait_for 10 "tracer READY" grep -q READY "$work/tracer.out"

  # Tracer -> Claude Code: sent while Claude is not running; the Mail stays
  # pending in the core until Claude's adapter registers.
  local tracer_to_claude="tracer to claude [[0:FLEET:0]] 4"
  local claude_to_tracer="claude to tracer [[153:Meteor Shower:7]] 5"
  "$bin" send --socket "$work/a.sock" --from "$tracer_addr" --to "$claude_addr" \
    --mail indep-1 --body "$tracer_to_claude" | grep -q "ACCEPTED mail=indep-1" || fail "send to Claude not accepted"
  wait_for 15 "coordinator accepted the Tracer's mail for Claude" grep -qF "$tracer_to_claude" "$work/coord.log"

  local mcp
  mcp="$(jq -cn --arg bin "$bin" --arg sock "$work/b.sock" --arg store "$work/claude.store" \
    '{mcpServers:{roger:{command:$bin,args:["mcp","--socket",$sock,"--store",$store,"--id-env","CLAUDE_CODE_SESSION_ID"]}}}')"
  (cd "$work" && timeout 180 claude -p \
    "Call the roger_inbox tool once. Then call the roger_send tool with to=$tracer_addr and body exactly: $claude_to_tracer. Do nothing else." \
    --model haiku --mcp-config "$mcp" --strict-mcp-config --tools "" \
    --session-id "$claude_addr" \
    --allowedTools mcp__roger__roger_inbox mcp__roger__roger_send \
    --no-session-persistence --max-budget-usd 1 \
    --output-format stream-json --verbose >"$work/claude.out" 2>"$work/claude.err") \
    || fail "claude -p failed: $(tail -c 500 "$work/claude.err")"
  jq -es --arg b "$tracer_to_claude" '
      [.[] | select(.type == "assistant") | .message.content[]?
        | select(.type == "tool_use" and .name == "mcp__roger__roger_inbox") | .id] as $ids
      | any(.[] | select(.type == "user") | .message.content[]?
          | select(.type == "tool_result" and (.tool_use_id as $t | $ids | index($t)) != null
                   and ((.content | if type == "string" then . else map(.text? // "") | join("") end)
                        | fromjson? | any(.mail[]?; .body == $b))); .)' \
    "$work/claude.out" >/dev/null \
    || fail "no roger_inbox tool_result carrying the Tracer's body in Claude's stream"
  jq -es --arg to "$tracer_addr" --arg b "$claude_to_tracer" '
      any(.[] | select(.type == "assistant") | .message.content[]?
          | select(.type == "tool_use" and .name == "mcp__roger__roger_send"
                   and .input.to == $to and .input.body == $b); .)' \
    "$work/claude.out" >/dev/null \
    || fail "Claude did not call roger_send with the expected input"
  log_count "$tracer_to_claude" 1 "$work/claude.store" || fail "Claude's Store must hold the Tracer's body exactly once"
  wait_for 15 "tracer DELIVERED Claude's mail" grep -q "DELIVERED mail=" "$work/tracer.out"
  wait_for 15 "Tracer Store holds Claude's body" grep -qF "$claude_to_tracer" "$work/tracer.store"
  log_count "$claude_to_tracer" 1 "$work/tracer.store" || fail "Tracer Store must hold Claude's body exactly once"

  # Receipts follow the acks; wait for the observable count, not a delay.
  wait_for 15 "two receipts at the coordinator" log_count '"ev":"receipt"' 2 "$work/coord.log"
  log_count '"ev":"mail"' 2 "$work/coord.log" || fail "coordinator must hold exactly two mail rows"
  log_count "$tracer_to_claude" 1 "$work/coord.log" || fail "coordinator must hold the Tracer's mail once"
  log_count "$claude_to_tracer" 1 "$work/coord.log" || fail "coordinator must hold Claude's mail once"

  "$ROOT/scripts/check-harness-free" >/dev/null || fail "core names a harness"
  echo "PASS independence: a session on the built-in MCP face (Claude Code via one real haiku call) and a Tracer exchanged Mail both ways, through one coordinator, two host daemons and one roger binary; each Store holds each body once, the coordinator one row for each"
}

# Proof 4. Two hosts, one coordinator. A local and B remote
# contend for one key through their own host daemons. Expiry is read from the
# committed deadline; nothing releases the key and nothing sweeps it.
CLAIM_KEY="[[0:build:0]]"
local_roger() { "$bin" "$@" --socket "$work/a.sock"; }
remote_roger() { ssh -n "$REMOTE_HOST" "bash -lc 'cd $remote_work && ./roger $* --socket $remote_work/b.sock'"; }

# expect_claim <want-exit> <want-prefix> <local|remote> <roger args...>
expect_claim() {
  local want="$1" prefix="$2" where="$3" out code=0; shift 3
  out="$("${where}_roger" "$@" --key "$CLAIM_KEY")" || code=$?
  [[ "$code" == "$want" ]] || fail "$where $1: expected exit $want, saw $code: $out"
  [[ "$out" == "$prefix"* ]] || fail "$where $1: expected '$prefix...', saw: $out"
}

# Both hosts' Board shows exactly one claim on the key, held by <owner>.
board_one_holder() {
  local owner="$1" where out lines
  for where in local remote; do
    out="$("${where}_roger" board)" || fail "$where board read failed"
    lines="$(grep -F "key=$CLAIM_KEY" <<<"$out" | grep '^CLAIM ' || true)"
    [[ "$(grep -c . <<<"$lines")" == 1 && "$lines" == "CLAIM holder=$owner "* ]] \
      || fail "$where board must show one holder $owner, saw: $out"
  done
}

# key_free_on_board <local|remote>: that host's Board has no claim on the key.
# A failed board read is a failure, not a free key.
key_free_on_board() {
  local out
  out="$("${1}_roger" board)" || return 1
  ! grep -qF "key=$CLAIM_KEY" <<<"$out"
}

claims() {
  local a="$SENDER" b="$RECIPIENT" stray="99999999-9999-4999-8999-999999999999" t0 t1 tr
  two_host_stack

  # A Claim is held by a session: register A locally and B remotely
  # before either claims. An owner nobody registered is refused.
  "$bin" session --socket "$work/a.sock" --id "$a" --store "$work/a.store" \
    >"$work/session-a.out" 2>&1 &
  pids+=("$!")
  remote_spawn session-b.pid session-b.out \
    "./roger session --socket $remote_work/b.sock --id $b --store $remote_work/b.store" \
    || fail "start remote session $b"
  wait_for 10 "session $a READY" grep -q READY "$work/session-a.out"
  wait_for 15 "session $b READY" ssh -n "$REMOTE_HOST" "grep -q READY $remote_work/session-b.out"
  expect_claim 3 "REFUSED op=acquire reason=\"owner $stray is not a registered session\" " \
    local claim --owner "$stray" --ttl-ms 4000

  t0="$(now_ms)"
  expect_claim 0 "CLAIMED op=acquire holder=$a " local claim --owner "$a" --ttl-ms 4000
  # The first deadline is the coordinator's clock at the acquire plus 4000 ms,
  # so it lies in [t0+4000, t1+4000]: renew before t0+4000, test past t1+4000.
  t1="$(now_ms)"
  expect_claim 3 "REFUSED op=acquire holder=$a " remote claim --owner "$b" --ttl-ms 4000
  expect_claim 3 "REFUSED op=renew holder=$a " remote renew --owner "$b" --ttl-ms 60000
  board_one_holder "$a"
  local_roger board | grep -q "^SESSION address=$b host=$remote_host_id " \
    || fail "board must place $b on Host id $remote_host_id"

  tr="$(now_ms)"
  (( tr < t0 + 4000 )) || fail "too slow: renewal would start after the first deadline"
  expect_claim 0 "RENEWED op=renew holder=$a " local renew --owner "$a" --ttl-ms 8000

  # Past the first deadline: the renewal holds the key.
  sleep "$(awk -v ms=$(( t1 + 4500 - $(now_ms) )) 'BEGIN { print (ms > 0 ? ms / 1000 : 0) }')"
  (( $(now_ms) >= t1 + 4000 )) || fail "sleep ended before the first deadline"
  expect_claim 3 "REFUSED op=acquire holder=$a " remote claim --owner "$b" --ttl-ms 4000
  board_one_holder "$a"

  # Past the renewed deadline the key is free: no release, no sweep.
  wait_for 20 "expiry frees the key" key_free_on_board local
  (( $(now_ms) >= tr + 8000 )) || fail "key freed before the renewed deadline"
  key_free_on_board remote || fail "remote board still shows the key after expiry"
  grep -q '"ev":"release"' "$work/coord.log" && fail "a release event freed the key, not expiry"
  expect_claim 3 "REFUSED op=renew " local renew --owner "$a" --ttl-ms 8000

  expect_claim 0 "CLAIMED op=acquire holder=$b " remote claim --owner "$b" --ttl-ms 60000
  expect_claim 3 "REFUSED op=acquire holder=$b " local claim --owner "$a" --ttl-ms 4000
  board_one_holder "$b"

  "$ROOT/scripts/check-harness-free" >/dev/null || fail "core names a harness"
  echo "PASS claims: unregistered owner refused, second owner refused across hosts, owner renewed past its first deadline, expiry freed the key with no release or sweep, and the board read from both hosts showed one holder"
}

# Proof 6: references keep both tokens verbatim through send, Store,
# delivery, and Board; a label change moves a session's display and never its
# Address or mailbox. Invariant 3: no code in src branches on those tokens.
references() {
  local meteor='[[153:Meteor Shower:7]]' fleet='[[0:FLEET:0]]'
  local body="start $meteor then $fleet"
  local sender_label="$fleet" recipient_label="$meteor" new_label="$fleet relabeled"

  # Invariant 3 source search: nothing in src parses a Reference or inspects a
  # label beyond carrying it. The patterns are the ways code would read an
  # token out of either. Unit-test modules (`#[cfg(test)]` to end of file)
  # are fixtures, not core, and are skipped.
  local hits f
  hits="$(for f in "$ROOT"/src/*.rs; do
    awk -v f="${f#"$ROOT"/}" '/^#\[cfg\(test\)\]/{exit} {print f":"NR":"$0}' "$f"
  done | grep -E '\[\[|\blabel\b[^;]*\b(parse|split|cmp|starts_with|strip_prefix|find|trim|chars|bytes|len)\b|\blabel\b[^;]*[=!<>]=' || true)"
  [[ -z "$hits" ]] || fail "src inspects a Reference or label:"$'\n'"$hits"

  loopback_stack
  # Sender on host-a, recipient on host-b, each registered with a label.
  "$bin" session --socket "$work/a.sock" --id "$SENDER" --label "$sender_label" \
    --store "$work/sender.store" >"$work/sender.out" 2>&1 &
  pids+=("$!")
  "$bin" session --socket "$work/b.sock" --id "$RECIPIENT" --label "$recipient_label" \
    --store "$work/tracer.store" >"$work/tracer.out" 2>&1 &
  pids+=("$!")
  wait_for 10 "sender READY" grep -q READY "$work/sender.out"
  wait_for 10 "tracer READY" grep -q READY "$work/tracer.out"

  # Send: the body returns from the coordinator's log byte-identical.
  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to "$RECIPIENT" \
    --mail ref-1 --body "$body" >"$work/send.out" || fail "send refused"
  wait_for 10 "ref-1 delivered" grep -q 'DELIVERED mail=ref-1' "$work/tracer.out"
  jq -e --arg b "$body" 'select(.ev == "mail" and .mail == "ref-1") | .body == $b' \
    "$work/coord.log" >/dev/null || fail "coordinator log body differs from what was sent"
  # Delivery: the host-b daemon's inbox holds the same bytes.
  jq -e --arg b "$body" 'select(.ev == "deliver" and .mail == "ref-1") | .body == $b' \
    "$work/b.log" >/dev/null || fail "host daemon delivery body differs"
  # Store: the recipient's record holds the same bytes, once.
  [[ "$(jq -r 'select(.mail == "ref-1") | .body' "$work/tracer.store")" == "$body" ]] \
    || fail "recipient Store body differs: $(cat "$work/tracer.store")"
  log_count "$body" 1 "$work/tracer.store" || fail "recipient Store must hold the body once"

  # Board: both hosts read both labels byte-identical. The Board read is
  # proof 4's `roger board`, one `SESSION address=<a> host=<h> connected=<bool> last_seen_ms=<ms> label=<l>` line
  # per registered session; the label is the rest of the line after `label=`.
  board_label() { # board_label <socket> <address>: the label the Board shows
    "$bin" board --socket "$1" | sed -n "s/^SESSION address=$2 host=[^ ]* connected=[a-z]* last_seen_ms=[0-9]* label=//p"
  }
  board_host() { # board_host <socket> <address>
    "$bin" board --socket "$1" | sed -n "s/^SESSION address=$2 host=\([^ ]*\) .*/\1/p"
  }
  local h label
  for h in a b; do
    "$bin" board --socket "$work/$h.sock" >"$work/board-$h.out" || fail "board read via host-$h"
    label="$(board_label "$work/$h.sock" "$SENDER")"
    [[ "$label" == "$sender_label" ]] || fail "board via host-$h shows sender label '$label'"
    label="$(board_label "$work/$h.sock" "$RECIPIENT")"
    [[ "$label" == "$recipient_label" ]] || fail "board via host-$h shows recipient label '$label'"
    [[ "$(board_host "$work/$h.sock" "$RECIPIENT")" == host-b ]] \
      || fail "board via host-$h places the recipient on the wrong host"
  done

  # Relabel the recipient from the other host: display changes, Address and
  # mailbox do not.
  "$bin" label --socket "$work/a.sock" --from "$RECIPIENT" --label "$new_label" \
    >"$work/relabel.out" || fail "relabel refused"
  label="$(board_label "$work/b.sock" "$RECIPIENT")"
  [[ "$label" == "$new_label" ]] || fail "board after relabel shows '$label'"
  [[ "$("$bin" board --socket "$work/b.sock" | grep -c "^SESSION address=$RECIPIENT ")" == 1 ]] \
    || fail "relabel changed the number of Board rows for the Address"
  [[ "$(board_host "$work/b.sock" "$RECIPIENT")" == host-b ]] || fail "relabel moved the recipient's host"
  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to "$RECIPIENT" \
    --mail ref-2 --body "after relabel $meteor" >>"$work/send.out" || fail "send after relabel refused"
  wait_for 10 "ref-2 delivered" grep -q 'DELIVERED mail=ref-2' "$work/tracer.out"
  log_count "after relabel $meteor" 1 "$work/tracer.store" \
    || fail "mail to the same Address after relabel must land in the same Store"
  [[ "$(wc -l <"$work/tracer.store")" == 2 ]] || fail "recipient Store should hold exactly two records"

  # A composite Address, `[[<token>:<label>:<token>]]<uuid>`, is the session's
  # whole routing identity: it registers, routes, stores, replies and shows on the
  # Board as one string, and a relabel never changes it.
  local agent='[[1a:Meteor Shower:zz]]aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'
  local director='[[2:FLEET:10]]bbbbbbbb-bbbb-4bbb-8bbb-bbbbbbbbbbbb'
  "$bin" session --socket "$work/a.sock" --id "$agent" --store "$work/agent.store" \
    >"$work/agent.out" 2>&1 &
  pids+=("$!")
  "$bin" session --socket "$work/b.sock" --id "$director" --store "$work/director.store" \
    >"$work/director.out" 2>&1 &
  pids+=("$!")
  wait_for 10 "composite agent READY" grep -q READY "$work/agent.out"
  wait_for 10 "composite director READY" grep -q READY "$work/director.out"
  "$bin" send --socket "$work/a.sock" --from "$agent" --to "$director" \
    --mail comp-1 --body "question $meteor" >"$work/comp.out" || fail "send to a composite Address refused"
  wait_for 10 "comp-1 delivered" grep -q 'DELIVERED mail=comp-1' "$work/director.out"
  jq -e --arg f "$agent" --arg t "$director" \
    'select(.ev == "mail" and .mail == "comp-1") | .from == $f and .to == $t' "$work/coord.log" >/dev/null \
    || fail "coordinator log changed a composite Address"
  jq -e --arg f "$agent" 'select(.mail == "comp-1") | .from == $f' "$work/director.store" >/dev/null \
    || fail "recipient Store changed the sender's composite Address"
  "$bin" send --socket "$work/b.sock" --from "$director" --to "$agent" \
    --mail comp-2 --body "answer" >>"$work/comp.out" || fail "reply to a composite Address refused"
  wait_for 10 "comp-2 delivered" grep -q 'DELIVERED mail=comp-2' "$work/agent.out"
  jq -e --arg f "$director" 'select(.mail == "comp-2") | .from == $f' "$work/agent.store" >/dev/null \
    || fail "reply Store changed the replier's composite Address"
  "$bin" label --socket "$work/a.sock" --from "$director" --label "renamed" >/dev/null || fail "relabel of a composite Address refused"
  [[ "$("$bin" board --socket "$work/b.sock" | grep -cF "SESSION address=$director ")" == 1 ]] \
    || fail "relabel changed the composite Address on the Board"
  "$bin" board --socket "$work/b.sock" | grep -F "address=$director " | grep -qF "label=renamed" \
    || fail "the Board does not show the relabeled display for the composite Address"

  # The label survives a coordinator restart with the same bytes.
  kill "$coord_pid"; wait "$coord_pid" 2>/dev/null || true
  "$bin" coordinator --bind "$coord" --data "$work/coord.log" \
    >"$work/coord2.out" 2>&1 &
  coord_pid=$!
  wait_for 10 "board after coordinator restart" "$bin" board --socket "$work/b.sock"
  label="$(board_label "$work/b.sock" "$RECIPIENT")"
  [[ "$label" == "$new_label" ]] || fail "board after coordinator restart shows '$label'"

  echo "PASS references: $meteor and $fleet returned byte-identical through send, Store, delivery, and Board; a composite Address round-tripped send, delivery, reply and Board; relabel changed display only, same Address, same Store, across a coordinator restart; src inspects no Reference"
}

# Proof 3. Two hosts, one coordinator. Three registered sessions: the
# sender's own locally, a quiet one remotely, and one remotely
# that is SIGKILLed between its Store write and its Ack. One
# broadcast must land in every Store exactly once, and each session reports
# the kind its delivery carried: every broadcast copy must report kind=broadcast.
THIRD="44444444-4444-4444-8444-444444444444"
broadcast() {
  local mail="bcast-1" body="fleet notice [[0:FLEET:0]] to every session"
  two_host_stack

  "$bin" session --socket "$work/a.sock" --id "$SENDER" --store "$work/sender.store" \
    >"$work/sender.out" 2>&1 &
  pids+=("$!")
  wait_for 10 "sender READY" grep -q READY "$work/sender.out"
  remote_spawn third.pid third.out \
    "./roger session --socket $remote_work/b.sock --id $THIRD --store $remote_work/third.store" \
    || fail "start remote third session"
  remote_spawn recipient.pid recipient1.out \
    "./roger session --socket $remote_work/b.sock --id $RECIPIENT --store $remote_work/recipient.store --hold-before-ack $remote_work/held.marker" \
    || fail "start remote recipient"
  wait_for 15 "three sessions registered at the coordinator" log_count '"ev":"session"' 3 "$work/coord.log"

  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to '*' --mail "$mail" --body "$body" \
    | grep -q "ACCEPTED mail=$mail" || fail "broadcast not accepted"

  wait_for 15 "recipient stored and holding before ack" \
    ssh -n "$REMOTE_HOST" "test -f $remote_work/held.marker"
  ssh -n "$REMOTE_HOST" "bash -lc 'kill -9 \$(cat $remote_work/recipient.pid)'" || fail "SIGKILL recipient"
  wait_for 15 "receipts from the two live sessions" log_count '"ev":"receipt"' 2 "$work/coord.log"
  grep -qF "\"mail\":\"$mail/$RECIPIENT\",\"session\"" "$work/coord.log" \
    && fail "receipt for the killed recipient exists before it acked"

  remote_spawn recipient.pid recipient2.out \
    "./roger session --socket $remote_work/b.sock --id $RECIPIENT --store $remote_work/recipient.store --hold-before-ack $remote_work/held.marker" \
    || fail "restart remote recipient"
  wait_for 15 "DELIVERED after restart" \
    ssh -n "$REMOTE_HOST" "grep -q 'DELIVERED mail=$mail/$RECIPIENT record=r-1' $remote_work/recipient2.out"
  wait_for 15 "three receipts" log_count '"ev":"receipt"' 3 "$work/coord.log"

  # A resent broadcast id fans out nothing new.
  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to '*' --mail "$mail" --body "$body" \
    | grep -q "ACCEPTED mail=$mail" || fail "resent broadcast not accepted"
  log_count '"ev":"broadcast"' 1 "$work/coord.log" || fail "coordinator must hold one broadcast event"
  log_count '"ev":"mail"' 0 "$work/coord.log" || fail "a broadcast must not be stored as directed mail"

  local addr
  for addr in "$SENDER" "$THIRD" "$RECIPIENT"; do
    log_count "\"ev\":\"receipt\",\"mail\":\"$mail/$addr\"" 1 "$work/coord.log" \
      || fail "coordinator must hold exactly one receipt for $addr"
  done

  local spec store out where
  for spec in "local sender" "remote third" "remote recipient"; do
    read -r where store <<<"$spec"
    out="${store}.out"; [[ "$store" == recipient ]] && out=recipient1.out
    if [[ "$where" == local ]]; then
      log_count "$body" 1 "$work/$store.store" || fail "$store Store must hold the body once"
      [[ "$(wc -l <"$work/$store.store")" == 1 ]] || fail "$store Store holds extra records"
      grep -q "^STORED mail=$mail/.* record=r-1 kind=broadcast$" "$work/$out" || fail "$store: delivery lacked kind=broadcast"
    else
      ssh -n "$REMOTE_HOST" "test \"\$(grep -cF '$body' $remote_work/$store.store)\" = 1 && test \"\$(wc -l <$remote_work/$store.store)\" = 1" \
        || fail "$store Store on $REMOTE_HOST must hold the body exactly once"
      ssh -n "$REMOTE_HOST" "grep -q '^STORED mail=$mail/.* record=r-1 kind=broadcast\$' $remote_work/$out" \
        || fail "$store: delivery lacked kind=broadcast"
    fi
  done

  "$ROOT/scripts/check-harness-free" >/dev/null || fail "core names a harness"
  echo "PASS broadcast: one broadcast reached all three registered sessions on both hosts, including one SIGKILLed between Store and Ack, exactly once each, every copy of kind broadcast"
}

# Invariant 2: no fixed-interval scan on the correctness path. Mail, receipts,
# claim expiry and unregister follow committed events, with every sweep
# disabled. The core has no sweep to disable: nothing in src runs on a timer
# (scripts/check-no-poll finds only the daemon's reconnect backoff, the
# daemon's bounded wait for one upstream reply, and the Store lock's single
# try). A sweep added later must take a switch that this check switches off; the
# quiet windows below fail while one runs, since they require that nothing is
# committed while nobody asks.
#
# Each phase isolates event triggers, so removing any one of them fails it:
#   directed  coordinator push on a committed send; host daemon push on a
#             committed deliver; host daemon forwarding an ack upstream
#   broadcast coordinator push of each committed copy
#   register  coordinator push of pending mail on a session's Register
#   hello     coordinator push of a host's pending mail on its daemon's hello
#   claims    expiry read from the committed deadline at the next request
#   leave     explicit unregister; a session connection closing; a host
#             daemon link dropping; expiry read at Broadcast, claim, relabel
#             and Board
#   offline   host daemon push from its inbox on a Register while the
#             coordinator is down; receipt replay on the next hello
# Every host daemon still running when the coordinator comes back is a fresh
# process, so the reconnect backoff never carries a result. Loopback only.
NP_GRACE_MS=2000
NP_LINK_LOST='upstream (error|connection closed)' # what a host daemon prints before it reconnects
no_poll() {
  command -v jq >/dev/null || fail "jq required"
  "$ROOT/scripts/check-no-poll" >/dev/null || fail "scripts/check-no-poll found an unmarked timed wait in src"
  (cd "$ROOT" && cargo build --release --offline -q --features test-hooks) || fail "cargo build"
  bin="$ROOT/target/release/roger"
  work="$(mktemp -d /tmp/roger-accept.XXXXXX)"
  token="$(head -c16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  export ROGER_TOKEN="$token"
  trap cleanup EXIT

  local r="$RECIPIENT" l="55555555-5555-4555-8555-555555555555"
  local x="66666666-6666-4666-8666-666666666666" e="77777777-7777-4777-8777-777777777777"
  local r_pid l_pid lines i d pid reader
  declare -A dpid=()

  coordinator_start() { # coordinator_start <bind> <out>
    "$bin" coordinator --bind "$1" --port-file "$work/port" --data "$work/coord.log" \
      --unregister-after-ms "$NP_GRACE_MS" >"$work/$2" 2>&1 &
    coord_pid=$!
    wait_for 10 "coordinator listening ($2)" grep -q 'coordinator listening' "$work/$2"
  }
  daemon_start() { # daemon_start <h> <generation>; sets dpid[<h>]
    "$bin" daemon --coordinator "$coord" --host-id "host-$1" --socket "$work/$1.sock" \
      --data "$work/$1.log" >"$work/daemon-$1$2.out" 2>&1 &
    dpid[$1]=$!
    pids+=("${dpid[$1]}")
    wait_for 10 "daemon $1$2 socket" test -S "$work/$1.sock"
  }
  daemon_stop() { kill -9 "${dpid[$1]}" 2>/dev/null; wait "${dpid[$1]}" 2>/dev/null || true; }
  tracer() { # tracer <h> <address> <name>: start a Tracer; sets tracer_pid
    "$bin" session --socket "$work/$1.sock" --id "$2" --store "$work/$3.store" >>"$work/$3.out" 2>&1 &
    tracer_pid=$!
    pids+=("$tracer_pid")
  }
  registered() { grep -qF "\"ev\":\"session\",\"session\":\"$1\"" "$work/coord.log"; }
  unregistered() { grep -qF "\"ev\":\"unregister\",\"session\":\"$1\"" "$work/coord.log"; }
  receipt() { grep -qF "\"ev\":\"receipt\",\"mail\":\"$1\"" "$work/coord.log"; }
  send() { # send <h> <to> <mail> <body>
    "$bin" send --socket "$work/$1.sock" --from "$SENDER" --to "$2" --mail "$3" --body "$4" \
      | grep -q "ACCEPTED mail=$3" || fail "send $3 not accepted"
  }
  # quiet <ms> <why>: nobody asks for <ms>; no log in the core may grow.
  quiet() {
    local before after
    before="$(cat "$work"/coord.log "$work"/?.log | wc -l)"
    sleep "$(awk -v ms="$1" 'BEGIN { print ms / 1000 }')"
    after="$(cat "$work"/coord.log "$work"/?.log | wc -l)"
    [[ "$before" == "$after" ]] || fail "$2: a log grew from $before to $after lines while nobody asked"
  }

  coordinator_start 127.0.0.1:0 coord1.out
  coord="127.0.0.1:$(cat "$work/port")"
  daemon_start a 1
  daemon_start b 1

  # directed: R is connected on host-b; a send from host-a reaches its Store,
  # and its ack becomes a receipt at the coordinator.
  tracer b "$r" r; r_pid=$tracer_pid
  wait_for 10 "R registered" registered "$r"
  send a "$r" np-1 "directed [[0:FLEET:0]]"
  wait_for 10 "directed: np-1 delivered to a connected session" grep -q 'DELIVERED mail=np-1 record=r-1' "$work/r.out"
  wait_for 10 "directed: receipt for np-1 at the coordinator" receipt np-1

  # broadcast: the committed copy is pushed to the connected session.
  send a '*' np-b1 "broadcast [[0:FLEET:0]]"
  wait_for 10 "broadcast: copy stored with kind broadcast" grep -q "STORED mail=np-b1/$r record=r-2 kind=broadcast" "$work/r.out"
  wait_for 10 "broadcast: receipt for the copy" receipt "np-b1/$r"

  # register: mail for an Address no host daemon has seen waits at the
  # coordinator until that Address registers.
  send a "$l" np-2 "before register [[153:Meteor Shower:7]]"
  grep -qF '"mail":"np-2"' "$work/a.log" && fail "register: np-2 reached a host daemon before its recipient registered"
  tracer a "$l" l; l_pid=$tracer_pid
  wait_for 10 "register: np-2 delivered on Register" grep -q 'DELIVERED mail=np-2 record=r-1' "$work/l.out"
  wait_for 10 "register: receipt for np-2" receipt np-2

  # hello: mail for a host whose daemon is down reaches that daemon's inbox
  # on its hello, before any session registers there.
  daemon_stop a
  wait "$l_pid" 2>/dev/null || true
  send b "$l" np-3 "while host-a is down"
  daemon_start a 2
  wait_for 10 "hello: np-3 in host-a's inbox with no session registered" grep -qF '"ev":"deliver","mail":"np-3"' "$work/a.log"
  tracer a "$l" l; l_pid=$tracer_pid
  wait_for 10 "hello: np-3 delivered" grep -q 'DELIVERED mail=np-3 record=r-2' "$work/l.out"
  wait_for 10 "hello: receipt for np-3" receipt np-3

  # claims: expiry is read from the committed deadline at the next request.
  local key="[[0:np:0]]" out
  out="$("$bin" claim --socket "$work/a.sock" --owner "$l" --key "$key" --ttl-ms 1500)" \
    || fail "claims: L's acquire refused: $out"
  out="$("$bin" claim --socket "$work/b.sock" --owner "$r" --key "$key" --ttl-ms 60000)" \
    && fail "claims: a second owner took a held key: $out"
  quiet 2000 "claims: past the deadline"
  out="$("$bin" claim --socket "$work/b.sock" --owner "$r" --key "$key" --ttl-ms 60000)" \
    || fail "claims: the key was not free at the first request after its deadline: $out"
  [[ "$out" == "CLAIMED op=acquire holder=$r "* ]] || fail "claims: expected R to hold the key, saw: $out"
  grep -q '"ev":"release"' "$work/coord.log" && fail "claims: a release freed the key, not expiry"

  # leave, explicit: an adapter whose stdin closes unregisters at once, with
  # no registered-set read to do it.
  mkfifo "$work/x.in"
  "$bin" adapter --socket "$work/b.sock" --id "$x" --store "$work/x.store" <"$work/x.in" >"$work/x.out" 2>&1 &
  pids+=("$!")
  exec 4>"$work/x.in"
  wait_for 10 "leave: X registered" registered "$x"
  exec 4>&-
  wait_for 10 "leave: X unregistered on stdin EOF" unregistered "$x"

  # leave, by grace: a session whose connection closed is unregistered by the
  # first registered-set read after the grace, by each kind of read, and by
  # nothing before it.
  i=0
  for reader in broadcast claim relabel board; do
    i=$((i + 1))
    d="8888888${i}-8888-4888-8888-88888888888${i}"
    tracer b "$d" "d$i"; pid=$tracer_pid
    wait_for 10 "leave: D$i registered" registered "$d"
    kill -9 "$pid"; wait "$pid" 2>/dev/null || true
    quiet $((NP_GRACE_MS + 700)) "leave: D$i past its grace"
    unregistered "$d" && fail "leave: D$i unregistered with no read"
    case "$reader" in
      broadcast) send a '*' np-b2 "after a grace"
        wait_for 10 "leave: np-b2 receipts" receipt "np-b2/$r"
        wait_for 10 "leave: np-b2 receipts" receipt "np-b2/$l" ;;
      claim) "$bin" claim --socket "$work/a.sock" --owner "$l" --key "[[1:np:1]]" --ttl-ms 60000 >/dev/null \
        || fail "leave: L's claim refused" ;;
      relabel) "$bin" label --socket "$work/a.sock" --from "$l" --label "[[0:FLEET:0]] L" >/dev/null \
        || fail "leave: relabel refused" ;;
      board) "$bin" board --socket "$work/a.sock" >"$work/board.out" || fail "leave: board read failed" ;;
    esac
    unregistered "$d" || fail "leave: D$i not unregistered by the first $reader after its grace (its connection closed, or that read does not expire)"
  done
  jq -e --arg d "88888881-8888-4888-8888-888888888881" --arg r "$r" --arg l "$l" \
    'select(.ev == "broadcast" and .mail == "np-b2") | .to | (any(. == $d) | not) and any(. == $r) and any(. == $l)' \
    "$work/coord.log" >/dev/null || fail "leave: np-b2 went to an expired session or missed a live one"
  grep -q '^SESSION address=8888888' "$work/board.out" && fail "leave: the Board shows an expired session"
  for d in "$r" "$l"; do
    grep -q "^SESSION address=$d .*connected=true" "$work/board.out" || fail "leave: connected session $d left the Board"
  done

  # leave, by a host daemon's link dropping: the daemon dies with its session
  # and cannot report the disconnect.
  daemon_start c 1
  tracer c "$e" e; pid=$tracer_pid
  wait_for 10 "leave: E registered" registered "$e"
  daemon_stop c
  wait "$pid" 2>/dev/null || true
  quiet $((NP_GRACE_MS + 700)) "leave: E past its grace"
  "$bin" board --socket "$work/a.sock" >"$work/board.out" || fail "leave: board read failed"
  unregistered "$e" || fail "leave: E not unregistered after its host daemon's link dropped"

  # offline: with the coordinator down, R registers and its host daemon
  # delivers np-5 from its inbox; the receipt reaches the coordinator on the
  # next hello.
  kill -9 "$r_pid"; wait "$r_pid" 2>/dev/null || true
  send a "$r" np-5 "while R is down"
  wait_for 10 "offline: np-5 in host-b's inbox" grep -qF '"ev":"deliver","mail":"np-5"' "$work/b.log"
  # Every host daemon so far kept its first link to the coordinator.
  grep -qE "$NP_LINK_LOST" "$work"/daemon-*.out && fail "a host daemon lost its link: $(grep -hE "$NP_LINK_LOST" "$work"/daemon-*.out)"
  kill "$coord_pid"; wait "$coord_pid" 2>/dev/null || true
  wait_for 10 "offline: host-b saw the coordinator go" grep -qE "$NP_LINK_LOST" "$work/daemon-b1.out"
  tracer b "$r" r; r_pid=$tracer_pid
  wait_for 10 "offline: np-5 delivered from host-b's inbox" grep -q 'DELIVERED mail=np-5' "$work/r.out"
  receipt np-5 && fail "offline: receipt for np-5 with the coordinator down"
  daemon_stop a
  daemon_stop b
  wait "$r_pid" 2>/dev/null || true
  coordinator_start "$coord" coord2.out
  daemon_start b 2
  wait_for 10 "offline: receipt for np-5 replayed on hello" receipt np-5

  # The host daemon running at the end connected at its first try.
  grep -qE "$NP_LINK_LOST" "$work/daemon-b2.out" && fail "host-b reconnected: $(grep -hE "$NP_LINK_LOST" "$work/daemon-b2.out")"

  # Nothing lost, nothing twice.
  for m in np-1 np-2 np-3 np-5 "np-b1/$r" "np-b2/$r" "np-b2/$l"; do
    log_count "\"ev\":\"receipt\",\"mail\":\"$m\"" 1 "$work/coord.log" || fail "$m: expected one receipt"
  done
  for m in np-1 np-2 np-3 np-5; do
    log_count "\"ev\":\"mail\",\"mail\":\"$m\"" 1 "$work/coord.log" || fail "$m: expected one mail row"
  done
  for m in np-1 np-b1/ np-b2/ np-5; do
    log_count "\"mail\":\"$m" 1 "$work/r.store" || fail "R's Store must hold $m once"
  done
  for m in np-2 np-3 np-b2/; do
    log_count "\"mail\":\"$m" 1 "$work/l.store" || fail "L's Store must hold $m once"
  done

  echo "PASS no-poll: with no sweep in the core, directed mail, a broadcast, mail pending at Register and at a host daemon's hello, and mail held in a host daemon's inbox while the coordinator was down were each delivered and acked once; receipts reached the coordinator on the ack and on replay; a claim expired at the first request past its deadline; sessions were unregistered on stdin EOF and, after their grace, by the first Broadcast, claim, relabel and Board read (after a closed connection and a dropped host link); and no log grew while nobody asked"
}

# Proof K7. Kind and headers arrive verbatim. Loopback: a throwaway coordinator and
# two host daemons (acceptance-lib), a Tracer, and a real `roger send`. Kinds and headers
# (non-ASCII text, an empty value, quotes, backslashes, newlines, key order, and the largest
# set the bounds allow) must reach the Store and the receipt byte-identical across a SIGKILL
# of the recipient between its Store write and its Ack and a restart of the coordinator and
# the host daemon; a refused set commits nothing; logs and a Store written before kind and
# headers existed replay. The expected JSON is built with jq, not by the core.
json_obj() { # json_obj key=value...: the headers as one JSON object, keys in the order given
  local out="" k v
  for kv in "$@"; do
    k="$(jq -n --arg v "${kv%%=*}" '$v')"; v="$(jq -n --arg v "${kv#*=}" '$v')"
    out+="${out:+,}$k:$v"
  done
  printf '{%s}' "$out"
}

headers() {
  command -v jq >/dev/null || fail "jq required to build the expected headers"
  loopback_stack
  local daemon_b_pid="${pids[1]}" out held="$work/held.marker"

  tracer1() { # the recipient, parked between its Store write and its Ack
    "$bin" session --socket "$work/b.sock" --id "$RECIPIENT" --store "$work/tracer.store" \
      --hold-before-ack "$held" >>"$work/tracer.out" 2>&1 &
    pids+=("$!"); tracer_pid=$!
  }
  tracer_pid=""
  tracer1
  wait_for 10 "tracer READY" grep -q READY "$work/tracer.out"

  # Directed mail with headers that stress the encoding, in an order that is not sorted.
  local hdrs=("z-last=4417" $'note=héllo wörld ✓ 日本語' "empty=" 'q=say "hi" \back\\slash'
              $'nl=line1\nline2\ttab\rend' "a-first=[[153:Meteor Shower:7]]")
  local want; want="$(json_obj "${hdrs[@]}")"
  local args=() h
  for h in "${hdrs[@]}"; do args+=(--header "$h"); done
  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to "$RECIPIENT" --mail k7-1 --body "directed" \
    "${args[@]}" | grep -q "ACCEPTED mail=k7-1" || fail "directed send with headers not accepted"
  wait_for 15 "recipient stored and holding before ack" test -f "$held"
  grep -qx "STORED mail=k7-1 record=r-1 kind=directed" "$work/tracer.out" || fail "STORED line lacks kind=directed: $(cat "$work/tracer.out")"
  [[ "$(grep '^HEADERS mail=k7-1 ' "$work/tracer.out")" == "HEADERS mail=k7-1 $want" ]] \
    || fail "recipient HEADERS differ from the sent set: $(grep '^HEADERS' "$work/tracer.out")"
  kill -9 "$tracer_pid"; wait "$tracer_pid" 2>/dev/null || true
  log_count '"ev":"receipt"' 0 "$work/coord.log" || fail "receipt exists before the recipient acked"

  # Restart the coordinator and the recipient's host daemon, then the recipient.
  kill "$coord_pid" "$daemon_b_pid"; wait "$coord_pid" "$daemon_b_pid" 2>/dev/null || true
  "$bin" coordinator --bind "$coord" --data "$work/coord.log" >"$work/coord2.out" 2>&1 &
  coord_pid=$!
  "$bin" daemon --coordinator "$coord" --host-id host-b --socket "$work/b.sock" --data "$work/b.log" \
    >"$work/daemon-b2.out" 2>&1 &
  pids+=("$!")
  wait_for 15 "daemon b socket" test -S "$work/b.sock"
  tracer1
  wait_for 15 "DELIVERED after restart" grep -q "DELIVERED mail=k7-1 record=r-1" "$work/tracer.out"
  [[ "$(wc -l <"$work/tracer.store")" == 1 ]] || fail "Store must hold the Mail once"
  grep -qF "\"kind\":\"directed\",\"headers\":$want}" "$work/tracer.store" || fail "Store entry lacks kind and the exact headers: $(cat "$work/tracer.store")"
  grep -qF "\"headers\":$want" "$work/coord.log" || fail "coordinator log lacks the exact headers"
  grep -qF "\"headers\":$want" "$work/b.log" || fail "host daemon log lacks the exact headers"
  local rc re
  wait_for 15 "receipt after the restarts" "$bin" receipt --socket "$work/a.sock" --mail k7-1
  rc="$("$bin" receipt --socket "$work/a.sock" --mail k7-1)"
  re="^RECEIPT mail=k7-1 to=$RECIPIENT record=r-1 accepted_at_ms=[0-9]+ receipted_at_ms=[0-9]+ latency_ms=[0-9]+ kind=directed\$"
  [[ "$(head -n1 <<<"$rc")" =~ $re ]] || fail "RECEIPT line: $rc"
  [[ "$(sed -n 2p <<<"$rc")" == "HEADERS mail=k7-1 $want" ]] || fail "receipt HEADERS differ: $rc"

  # A Broadcast with the largest set the bounds allow: every copy carries kind and the set.
  local pad i k max=() margs=()
  pad="$(printf 'é%.0s' $(seq 2047))"
  for i in $(seq 32 -1 1); do max+=("$(printf '%0128d' "$i")=$(printf '%02d' "$i")$pad"); done
  for h in "${max[@]}"; do margs+=(--header "$h"); done
  local wantmax; wantmax="$(json_obj "${max[@]}")"
  "$bin" send --socket "$work/a.sock" --from "$SENDER" --to '*' --mail k7-b --body "all" \
    "${margs[@]}" | grep -q "ACCEPTED mail=k7-b" || fail "largest set refused"
  wait_for 15 "broadcast copy acked" grep -q "DELIVERED mail=k7-b/$RECIPIENT" "$work/tracer.out"
  grep -qx "STORED mail=k7-b/$RECIPIENT record=r-2 kind=broadcast" "$work/tracer.out" || fail "copy STORED line lacks kind=broadcast"
  [[ "$(grep "^HEADERS mail=k7-b/" "$work/tracer.out")" == "HEADERS mail=k7-b/$RECIPIENT $wantmax" ]] \
    || fail "the largest set changed on the way"
  # Compared in the shell: the set is too large for one grep argument.
  [[ "$(tail -n1 "$work/tracer.store")" == *"\"kind\":\"broadcast\",\"headers\":$wantmax}" ]] || fail "Store entry lacks the largest set"
  wait_for 15 "receipt for the copy" "$bin" receipt --socket "$work/a.sock" --mail "k7-b/$RECIPIENT"
  rc="$("$bin" receipt --socket "$work/a.sock" --mail "k7-b/$RECIPIENT")"
  [[ "$(head -n1 <<<"$rc")" == *" kind=broadcast" ]] || fail "copy RECEIPT line lacks kind=broadcast: $(head -n1 <<<"$rc")"
  [[ "$(sed -n 2p <<<"$rc")" == "HEADERS mail=k7-b/$RECIPIENT $wantmax" ]] || fail "copy receipt HEADERS differ"

  # Refused sets commit nothing: no Mail, no log line, unknown to the receipt.
  local mails_before bcast_before n=0 refused reason
  mails_before="$(grep -c '"ev":"mail"' "$work/coord.log")"; bcast_before="$(grep -c '"ev":"broadcast"' "$work/coord.log")"
  refuse() { # refuse <to> <expected reason substring> <header args...>
    local to="$1" want_reason="$2"; shift 2
    n=$((n + 1))
    if "$bin" send --socket "$work/a.sock" --from "$SENDER" --to "$to" --mail "k7-r$n" --body x "$@" >"$work/refused.out" 2>&1; then
      fail "refused set accepted: $want_reason"
    fi
    grep -qF -- "$want_reason" "$work/refused.out" || fail "refusal lacks '$want_reason': $(cat "$work/refused.out")"
    if "$bin" receipt --socket "$work/a.sock" --mail "k7-r$n" >/dev/null 2>&1; then fail "refused k7-r$n exists"; fi
  }
  local over=(); for i in $(seq 1 33); do over+=(--header "k$i=v"); done
  local big; big="$(head -c 4097 /dev/zero | tr '\0' x)"
  for to in "$RECIPIENT" '*'; do
    refuse "$to" "headers: expected at most 32 headers, saw 33" "${over[@]}"
    refuse "$to" 'expected a value of at most 4096 bytes, saw 4097' --header "k=$big"
    refuse "$to" "expected a key of 1 to 128 bytes, saw a key of 129 bytes" --header "$(head -c 129 /dev/zero | tr '\0' k)=v"
    refuse "$to" "expected a key of 1 to 128 bytes, saw a key of 0 bytes" --header "=v"
    refuse "$to" 'headers: duplicate key' --header a=1 --header a=2
  done
  [[ "$(grep -c '"ev":"mail"' "$work/coord.log")" == "$mails_before" ]] || fail "a refused set committed a Mail"
  [[ "$(grep -c '"ev":"broadcast"' "$work/coord.log")" == "$bcast_before" ]] || fail "a refused set committed a Broadcast"
  ! grep -q 'k7-r' "$work/coord.log" "$work/a.log" "$work/b.log" || fail "a refused Mail left a log line"

  # Replay: a coordinator log, a host daemon log and a Store written before kind and headers.
  local to="$RECIPIENT" old="$work/old"
  mkdir -p "$old"
  {
    printf '%s\n' '{"ev":"session","session":"'"$to"'","host":"host-old"}'
    printf '%s\n' '{"ev":"mail","mail":"old-c1","from":"'"$SENDER"'","to":"'"$to"'","body":"stored","accepted_at_ms":1}'
    printf '%s\n' '{"ev":"mail","mail":"old-c2","from":"'"$SENDER"'","to":"'"$to"'","body":"new","accepted_at_ms":2}'
    printf '%s\n' '{"ev":"broadcast","mail":"old-b","from":"'"$SENDER"'","body":"all","to":["'"$to"'"],"accepted_at_ms":3}'
  } >"$old/coord.log"
  printf '%s\n' '{"record":"r-1","mail":"old-c1","from":"'"$SENDER"'","body":"stored"}' >"$old/tracer.store"
  local dl='{"ev":"deliver","mail":"%s","from":"'"$SENDER"'","to":"'"$to"'","body":"d"%s}\n'
  {
    printf "$dl" old-d1 ',"wake":false' # legacy-wire: read shape, a Broadcast copy
    printf "$dl" old-d2 ',"wake":true'  # legacy-wire: read shape, directed
    printf "$dl" old-d3 ''
  } >"$old/daemon.log"
  "$bin" coordinator --bind 127.0.0.1:0 --port-file "$old/port" --data "$old/coord.log" >"$old/coord.out" 2>&1 &
  pids+=("$!")
  wait_for 10 "old coordinator port" test -s "$old/port"
  "$bin" daemon --coordinator "127.0.0.1:$(cat "$old/port")" --host-id host-old --socket "$old/d.sock" \
    --data "$old/daemon.log" >"$old/daemon.out" 2>&1 &
  pids+=("$!")
  wait_for 10 "old daemon socket" test -S "$old/d.sock"
  "$bin" session --socket "$old/d.sock" --id "$to" --store "$old/tracer.store" >"$old/tracer.out" 2>&1 &
  pids+=("$!")
  wait_for 15 "old Mail delivered" grep -q "DELIVERED mail=old-c2" "$old/tracer.out"
  wait_for 15 "old Broadcast copy delivered" grep -q "DELIVERED mail=old-b/$to" "$old/tracer.out"
  wait_for 15 "old daemon inbox delivered" grep -q "DELIVERED mail=old-d3" "$old/tracer.out"
  grep -q "^STORED mail=old-c2 record=r-[0-9]* kind=directed$" "$old/tracer.out" || fail "old mail event is not directed"
  grep -q "^STORED mail=old-b/$to record=r-[0-9]* kind=broadcast$" "$old/tracer.out" || fail "old broadcast event is not kind broadcast"
  grep -q "^STORED mail=old-d1 record=r-[0-9]* kind=broadcast$" "$old/tracer.out" || fail "old daemon event with the older flag false is not kind broadcast"
  grep -q "^STORED mail=old-d2 record=r-[0-9]* kind=directed$" "$old/tracer.out" || fail "old daemon event with the older flag true is not directed"
  grep -q "^STORED mail=old-d3 record=r-[0-9]* kind=directed$" "$old/tracer.out" || fail "old daemon event with no flag is not directed"
  grep -q "^DELIVERED mail=old-c1 record=r-1$" "$old/tracer.out" || fail "stored old Mail did not reuse its record"
  ! grep -q "STORED mail=old-c1" "$old/tracer.out" || fail "stored old Mail was written again"
  [[ "$(grep -c '"mail":"old-c1"' "$old/tracer.store")" == 1 ]] || fail "old Store holds old-c1 other than once"
  ! grep -q HEADERS "$old/tracer.out" || fail "a Mail with no headers printed a HEADERS line"
  rc="$("$bin" receipt --socket "$old/d.sock" --mail old-c2)"
  [[ "$rc" == RECEIPT*" kind=directed" ]] || fail "old coordinator mail receipt: $rc"

  echo "PASS headers: kinds and headers (non-ASCII, empty, quotes, backslashes, newlines, order, the largest set) arrived byte-identical in the Store and the receipt across a recipient SIGKILL between Store and Ack and a restart of the coordinator and host daemon; every refused set committed nothing; old coordinator and host daemon logs and an old Store replayed with the right kinds"
}

# Proof K8 (loopback, no model): `roger mcp` is a session. A small MCP client in bash + jq
# drives it over stdio. Each client keeps its request counter in a file, since every call runs
# in a subshell; each server's stdin is a fifo held open by a numbered descriptor.
mcp() {
  loopback_stack
  local A1="11111111-1111-4111-8111-111111111111"
  local COMPOSITE="[[1a:FLEET:zz]]$RECIPIENT"
  local sock="$work/a.sock" r

  declare -A MFD MPID
  mcp_start() { # mcp_start <name> <roger mcp args...>   (env passes through)
    local n="$1" fd; shift
    if [[ -n "${MFD[$n]:-}" ]]; then eval "exec ${MFD[$n]}>&-"; MFD[$n]=""; fi
    rm -f "$work/$n.in" "$work/$n.id"; mkfifo "$work/$n.in"
    "$bin" mcp --socket "$sock" "$@" <"$work/$n.in" >"$work/$n.out" 2>"$work/$n.err" &
    MPID[$n]=$!; pids+=("${MPID[$n]}")
    exec {fd}>"$work/$n.in"; MFD[$n]=$fd
  }
  mcp_close() { eval "exec ${MFD[$1]}>&-"; MFD[$1]=""; }
  mcp_send() { printf '%s\n' "$2" >&"${MFD[$1]}"; }
  mcp_wait_id() { # mcp_wait_id <name> <id> [seconds]: print the response line with that id
    local n="$1" id="$2" d=$(( $(date +%s) + ${3:-20} )) l
    while (( $(date +%s) < d )); do
      l="$(jq -c --argjson id "$id" 'select(.id == $id)' "$work/$n.out" 2>/dev/null | head -n1 || true)"
      [[ -n "$l" ]] && { printf '%s' "$l"; return 0; }
      sleep 0.05
    done
    echo "no response id $id from $n: $(tail -3 "$work/$n.out") / $(tail -3 "$work/$n.err")" >&2; return 1
  }
  mcp_rpc() { # mcp_rpc <name> <method> <params-json> [seconds] -> the response line
    local n="$1" id
    id=$(( $(cat "$work/$n.id" 2>/dev/null || echo 0) + 1 )); echo "$id" >"$work/$n.id"
    mcp_send "$n" "$(jq -cn --argjson id "$id" --arg m "$2" --argjson p "${3:-{\}}" '{jsonrpc:"2.0",id:$id,method:$m,params:$p}')"
    mcp_wait_id "$n" "$id" "${4:-20}"
  }
  mcp_init() {
    local resp; resp="$(mcp_rpc "$1" initialize '{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"acceptance","version":"0"}}')" || return 1
    mcp_send "$1" '{"jsonrpc":"2.0","method":"notifications/initialized"}'
    printf '%s' "$resp"
  }
  mcp_call() { # mcp_call <name> <tool> <args-json> [seconds] -> the whole response line
    mcp_rpc "$1" tools/call "$(jq -cn --arg t "$2" --argjson a "${3:-{\}}" '{name:$t,arguments:$a}')" "${4:-20}"
  }
  mcp_tool() { # the result text; fails on isError
    local resp; resp="$(mcp_call "$@")" || return 1
    if [[ "$(jq -r '.result.isError // false' <<<"$resp")" == true ]]; then jq -r '.result.content[0].text' <<<"$resp" >&2; return 9; fi
    jq -r '.result.content[0].text' <<<"$resp"
  }
  mcp_tool_err() { # expects isError; prints its text
    local resp; resp="$(mcp_call "$@")" || return 1
    [[ "$(jq -r '.result.isError // false' <<<"$resp")" == true ]] || { echo "not an error: $resp" >&2; return 1; }
    jq -r '.result.content[0].text' <<<"$resp"
  }

  # ---- handshake, tool list, unknown method ----
  mcp_start a --id "$A1" --store "$work/a.store"
  r="$(mcp_init a)"
  [[ "$(jq -r .result.protocolVersion <<<"$r")" == 2025-06-18 ]] || fail "protocolVersion: $r"
  jq -e '.result.capabilities.tools != null and .result.serverInfo.name == "roger"' <<<"$r" >/dev/null || fail "initialize result: $r"
  local tools; tools="$(mcp_rpc a tools/list '{}' | jq -r '[.result.tools[].name] | sort | join(" ")')"
  [[ "$tools" == "roger_board roger_claim roger_inbox roger_label roger_receipt roger_registered roger_release roger_renew roger_send" ]] || fail "tools: $tools"
  mcp_tool a roger_registered '{"wait_seconds":10}' | jq -e '.registered == true' >/dev/null || fail "roger_registered must report the coordinator holds the Register"
  mcp_rpc a ping '{}' | jq -e '.result == {}' >/dev/null || fail "ping"
  mcp_rpc a no/such/method '{}' | jq -e '.error.code == -32601' >/dev/null || fail "an unknown method must be -32601"
  mcp_rpc a initialize '{"protocolVersion":"2024-11-05"}' | jq -e '.result.protocolVersion == "2024-11-05"' >/dev/null || fail "an older protocol version must be answered with itself"
  printf '%s\n' 'not json' >&"${MFD[a]}"
  wait_for 10 "a parse error answer" bash -c "jq -e 'select(.id == null and .error.code == -32700)' '$work/a.out'"

  # ---- an Address from a named variable is used verbatim (a whole composite), by --id-env ----
  MY_CONVERSATION="$COMPOSITE" mcp_start b --id-env MY_CONVERSATION --store "$work/b.store"
  mcp_init b >/dev/null
  local bd; bd="$(mcp_tool a roger_board '{}')"
  jq -e --arg me "$A1" --arg c "$COMPOSITE" '.me == $me and ([.sessions[].session] | index($me) != null) and ([.sessions[].session] | index($c) != null)' <<<"$bd" >/dev/null || fail "board: $bd"
  [[ "$(mcp_tool b roger_board '{}' | jq -r .me)" == "$COMPOSITE" ]] || fail "the composite Address was not registered verbatim"

  # ---- mail with headers; the inbox, its Cursor, and the Store holding each body once ----
  local s; s="$(mcp_tool a roger_send "$(jq -cn --arg to "$COMPOSITE" '{to:$to, mail:"m1", body:"hello ✓", headers:{"x-ticket":"4417","note":"a \"b\"\n"}}')")"
  [[ "$(jq -r .mail <<<"$s")" == m1 ]] || fail "send result: $s"
  local in1; in1="$(mcp_tool b roger_inbox '{"wait_seconds":10}')"
  jq -e --arg a "$A1" '(.mail | length) == 1 and .mail[0].mail == "m1" and .mail[0].from == $a and .mail[0].body == "hello ✓" and .mail[0].kind == "directed" and .mail[0].headers == {"x-ticket":"4417","note":"a \"b\"\n"} and .cursor == .mail[0].record' <<<"$in1" >/dev/null || fail "inbox: $in1"
  mcp_tool b roger_inbox '{"wait_seconds":0}' | jq -e '.mail == [] and .cursor == null' >/dev/null || fail "a second read must be empty"
  log_count '"mail":"m1"' 1 "$work/b.store" || fail "the Store must hold m1 once"
  [[ -s "$work/b.store.cursor" ]] || fail "no Cursor file next to the Store"
  rc="$(mcp_tool a roger_receipt '{"mail":"m1"}')"
  jq -e --arg c "$COMPOSITE" '.to == $c and .record == "r-1" and .kind == "directed" and .headers["x-ticket"] == "4417" and (.accepted_at_ms | type) == "number"' <<<"$rc" >/dev/null || fail "receipt: $rc"
  mcp_tool_err a roger_receipt '{"mail":"nope"}' | grep -qi "nope" || fail "an unknown mail's receipt must be an error naming it"
  mcp_tool_err a roger_send "$(jq -cn --arg to "$COMPOSITE" '{to:$to, body:"x", headers:{"a":1}}')" | grep -qi "header" || fail "a refused header set must say why"
  mcp_tool_err a roger_send '{"to":5,"body":"x"}' | grep -q "expected.*saw" || fail "a wrong-typed argument must say what was expected and seen"
  mcp_tool_err a roger_nothing '{}' | grep -q "roger_nothing" || fail "an unknown tool must be named in its error"

  # ---- limit and peek ----
  local i
  for i in 1 2 3; do mcp_tool a roger_send "$(jq -cn --arg to "$COMPOSITE" --arg m "p$i" '{to:$to,mail:$m,body:$m}')" >/dev/null; done
  wait_for 15 "p3 in the Store" grep -q '"mail":"p3"' "$work/b.store"
  mcp_tool b roger_inbox '{"peek":true,"limit":2}' | jq -e '[.mail[].mail] == ["p1","p2"]' >/dev/null || fail "peek limit 2"
  mcp_tool b roger_inbox '{"peek":true,"limit":2}' | jq -e '[.mail[].mail] == ["p1","p2"]' >/dev/null || fail "peek must not move the Cursor"
  mcp_tool b roger_inbox '{"limit":2}' | jq -e '[.mail[].mail] == ["p1","p2"]' >/dev/null || fail "read limit 2"
  mcp_tool b roger_inbox '{"wait_seconds":0}' | jq -e '[.mail[].mail] == ["p3"]' >/dev/null || fail "the rest after the limit"

  # ---- a waiting inbox does not block another call; the next delivery ends the wait ----
  local id; id=$(( $(cat "$work/b.id") + 1 )); echo "$id" >"$work/b.id"
  mcp_send b "$(jq -cn --argjson id "$id" '{jsonrpc:"2.0",id:$id,method:"tools/call",params:{name:"roger_inbox",arguments:{wait_seconds:30}}}')"
  mcp_rpc b ping '{}' | jq -e '.result == {}' >/dev/null || fail "a waiting inbox blocked a ping"
  mcp_tool b roger_board '{}' >/dev/null || fail "a waiting inbox blocked the board"
  mcp_tool a roger_send "$(jq -cn --arg to "$COMPOSITE" '{to:$to,mail:"w1",body:"late"}')" >/dev/null
  r="$(mcp_wait_id b "$id" 10)" || fail "the delivery did not end the wait"
  jq -r '.result.content[0].text' <<<"$r" | jq -e '[.mail[].mail] == ["w1"]' >/dev/null || fail "waiting read: $r"

  # ---- a Broadcast carries kind broadcast ----
  mcp_tool a roger_send '{"to":"*","body":"all","mail":"bc1"}' >/dev/null
  mcp_tool b roger_inbox '{"wait_seconds":10}' | jq -e '.mail[0].kind == "broadcast"' >/dev/null || fail "broadcast kind"

  # ---- claims: refusal is a result, not an error ----
  r="$(mcp_tool a roger_claim '{"key":"job-1","ttl_seconds":60}')"; jq -e '.ok == true and .op == "acquire"' <<<"$r" >/dev/null || fail "claim: $r"
  r="$(mcp_tool b roger_claim '{"key":"job-1","ttl_seconds":60}')"; jq -e --arg a "$A1" '.ok == false and .holder == $a' <<<"$r" >/dev/null || fail "a second owner must be refused with the holder: $r"
  r="$(mcp_tool a roger_renew '{"key":"job-1","ttl_seconds":120}')"; jq -e '.ok == true and .remaining_ms > 60000' <<<"$r" >/dev/null || fail "renew: $r"
  r="$(mcp_tool a roger_release '{"key":"job-1"}')"; jq -e '.ok == true' <<<"$r" >/dev/null || fail "release: $r"
  r="$(mcp_tool b roger_claim '{"key":"job-1"}')"; jq -e '.ok == true' <<<"$r" >/dev/null || fail "claim after release: $r"
  mcp_tool a roger_label '{"label":"builder"}' | jq -e '.label == "builder" and .session == "'"$A1"'"' >/dev/null || fail "label"
  mcp_tool a roger_board '{}' | jq -e '[.sessions[] | select(.label == "builder")] | length == 1' >/dev/null || fail "the label is not on the Board"

  # ---- the Cursor survives a restart; SIGKILL between the Store write and the Ack loses nothing ----
  mcp_tool b roger_inbox '{"wait_seconds":0}' >/dev/null
  mcp_close b; wait "${MPID[b]}" || fail "roger mcp must exit 0 when its stdin closes"
  rm -f "$work/held"
  MY_CONVERSATION="$COMPOSITE" mcp_start b --id-env MY_CONVERSATION --store "$work/b.store" --hold-before-ack "$work/held"
  mcp_init b >/dev/null
  mcp_tool a roger_send '{"to":"'"$COMPOSITE"'","mail":"k1","body":"survive","headers":{"h":"v"}}' >/dev/null
  wait_for 15 "held marker" test -f "$work/held"
  grep -q '"mail":"k1"' "$work/b.store" || fail "k1 is not in the Store before the kill window"
  kill -9 "${MPID[b]}"; wait "${MPID[b]}" 2>/dev/null || true
  if "$bin" receipt --socket "$sock" --mail k1 | grep -q '^RECEIPT'; then fail "a receipt before the Ack"; fi
  MY_CONVERSATION="$COMPOSITE" mcp_start b --id-env MY_CONVERSATION --store "$work/b.store"
  mcp_init b >/dev/null
  wait_for 15 "receipt after restart" bash -c "'$bin' receipt --socket '$sock' --mail k1 | grep -q '^RECEIPT'"
  "$bin" receipt --socket "$sock" --mail k1 | grep -q 'record=r-' || fail "the receipt does not name the record"
  local want; want="$(jq -r 'select(.mail == "k1") | .record' "$work/b.store")"
  mcp_tool a roger_receipt '{"mail":"k1"}' | jq -e --arg r "$want" '.record == $r' >/dev/null || fail "the receipt must name the Store's record $want"
  log_count '"mail":"k1"' 1 "$work/b.store" || fail "k1 stored more than once"
  r="$(mcp_tool b roger_inbox '{"wait_seconds":5}')"
  jq -e '[.mail[].mail] == ["k1"]' <<<"$r" >/dev/null || fail "after the restart the inbox must hold only k1: $r"

  # ---- closing stdin unregisters ----
  mcp_close b; wait "${MPID[b]}" || fail "roger mcp must exit 0 when its stdin closes"
  wait_for 10 "b left the Board" bash -c "! '$bin' board --socket '$sock' | grep -qF 'SESSION address=$COMPOSITE '"

  # ---- the default Store: a health check leaves nothing; an explicit Store is never removed ----
  local state="$work/state" env_id="health-$$"
  mkdir -p "$state"
  XDG_STATE_HOME="$state" mcp_start h --id "$env_id"
  mcp_init h >/dev/null
  [[ -f "$state/roger/mcp/$env_id.store" ]] || fail "the default Store is not at XDG_STATE_HOME/roger/mcp/<address>.store"
  mcp_close h; wait "${MPID[h]}" || fail "health check exit"
  [[ ! -e "$state/roger/mcp/$env_id.store" && ! -e "$state/roger/mcp/$env_id.store.cursor" ]] || fail "an empty default Store was left behind"
  [[ -e "$work/a.store" ]] || fail "an explicit Store was removed"

  # ---- a lost daemon connection ends the process nonzero with the reason on stderr ----
  kill "${pids[0]}"
  local st=0; wait "${MPID[a]}" || st=$?
  [[ "$st" != 0 ]] || fail "roger mcp must exit nonzero when the host daemon is lost"
  grep -q "host daemon" "$work/a.err" || fail "no reason on stderr: $(cat "$work/a.err")"
  jq -e . "$work/a.out" >/dev/null || fail "stdout must carry only protocol messages"

  # ---- a missing socket is an error naming the path ----
  "$bin" mcp --socket "$work/none.sock" --store "$work/n.store" </dev/null >"$work/n.out" 2>"$work/n.err" && fail "a missing socket must fail"
  grep -q "$work/none.sock" "$work/n.err" || fail "the missing-socket error must name the path: $(cat "$work/n.err")"
  [[ ! -s "$work/n.out" ]] || fail "stdout must carry only protocol messages"

  echo "PASS mcp: handshake, tools, headers, Cursor (limit, peek, restart), claims, receipt, a composite Address verbatim, a waiting inbox that blocks nothing, SIGKILL between Store and Ack losing nothing, default Store cleanup"
}

usage() {
  echo "usage: $0 <cross-host|no-poll|independence|claims|references|broadcast|headers|mcp>"
  echo "cross-host, claims, broadcast require ROGER_REMOTE_HOST (SSH destination) and"
  echo "ROGER_ACCEPT_BIND (local IPv4 reachable from that host). Other suites use loopback."
}
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; exit 0; fi
[[ $# == 1 ]] || { usage >&2; exit 2; }
case "$1" in
  cross-host) cross_host ;;
  no-poll) no_poll ;;
  independence) independence ;;
  claims) claims ;;
  references) references ;;
  broadcast) broadcast ;;
  headers) headers ;;
  mcp) mcp ;;
  *) usage >&2; exit 2 ;;
esac
