#!/usr/bin/env bash
# Invariant check: the core never learns which harness runs a session.
# Coordinator, host daemon, client, and adapter name no harness, read no
# harness store, and link no harness SDK. Only a shim may know.
#
# The core is every file in the checkout (tracked or untracked, minus
# .gitignore) outside shims/, VECTORS/, and docs/reviews/: source, tests, scripts, deploy
# units, and docs, README.md included. The sealed documents (purpose, proofs, invariants,
# terms) live outside the repo and were scanned with this check before they were sealed. A model
# name counts as a harness name. Exempt:
#   frontmatter         a leading YAML block (--- ... ---) in a markdown file
#                       records who wrote the file (agent:, session:), not
#                       what the core is
#   shims/              adapters on top of the core; each may know its harness
#   VECTORS/            the record of what was tried
#   docs/reviews/       historical review evidence, not core docs
#   scripts/acceptance  proofs 2 and 5 run real harnesses by definition
#   scripts/check-harness-free  this list of names
#
# Usage: scripts/check-harness-free [path ...]   (default: the whole core)
set -euo pipefail
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then echo "usage: $0 [path ...] (default: whole core)"; exit 0; fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Whole-word matches only: "pipe" and "copy" must not trip on "pi". `cursor` is not
# listed: Cursor is a term of the core (a session's read position, GLOSSARY), and a word
# match cannot tell it from the editor of that name.
HARNESSES='pi|claude|claude-code|codex|gemini|aider|copilot|herdr|zellij|opencode|goose|cline|roo|amp|letta|windsurf'
MODELS='anthropic|openai|fireworks|opus|sonnet|haiku|gpt|deepseek|llama|qwen|mistral|grok|kimi|glm'

# A checkout lists its files through git; a plain export (no .git) lists the tree minus target/.
list_files() {
  if git rev-parse --git-dir >/dev/null 2>&1; then
    git ls-files --cached --others --exclude-standard -- "$@"
  else
    find "$@" -type f -not -path '*/target/*' -not -path '*/.git/*' | sed 's#^\./##'
  fi
}
mapfile -t files < <(list_files "${@:-.}" |
  grep -vE '^(shims|VECTORS|\.slice)/|^(KERNEL|INVARIANTS|GLOSSARY)\.md$|^docs/reviews/|^scripts/(acceptance|check-harness-free)$' | sort -u |
  while IFS= read -r f; do [[ -f "$f" ]] && printf '%s\n' "$f"; done)
((${#files[@]})) || { echo "FAIL: no core files under ${*:-.}" >&2; exit 1; }

status=0
# Markdown frontmatter lines are blanked, not dropped, so line numbers hold. A
# leading --- that never closes is not frontmatter: the whole file is scanned.
hits="$(for f in "${files[@]}"; do
  if [[ "$f" == *.md ]]; then
    awk 'NR == 1 && /^---[[:space:]]*$/ { fm = 1 }
         fm { buf[++n] = $0; if (NR > 1 && /^---[[:space:]]*$/) { for (i = 1; i <= n; i++) print ""; fm = n = 0 }; next }
         { print }
         END { for (i = 1; i <= n; i++) print buf[i] }' "$f" |
      grep -HniIE --label="$f" "\b($HARNESSES|$MODELS)\b" || true
  else
    grep -HniIE "\b($HARNESSES|$MODELS)\b" -- "$f" || true
  fi
done)"
if [[ -n "$hits" ]]; then
  echo "FAIL: harness or model named in the core (only shims/ may name one):" >&2
  echo "$hits" >&2
  status=1
fi

deps="$(awk '/^\[dependencies\]/{f=1;next} /^\[/{f=0} f && /^[[:space:]]*[A-Za-z0-9_-]+[[:space:]]*=/{print}' Cargo.toml)"
if [[ -n "$deps" ]]; then
  echo "FAIL: core links external crates (a harness SDK is one of the risks):" >&2
  echo "$deps" >&2
  status=1
fi

if [[ "$status" == 0 ]]; then
  echo "PASS harness-free: no harness or model name in ${#files[@]} core files under ${*:-.}, no external crate dependencies"
fi
exit "$status"
