{
  "name": "roger-wilco",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "description": "Durable session messaging and coordination for Pi over SSE and HTTP.",
  "type": "module",
  "files": ["src", "deploy", "docs", "scripts", ".node-version", "README.md", "CONTEXT.md", "LICENSE", "THIRD-PARTY-NOTICES", "SOURCE-MANIFEST.md"],
  "bin": {
    "roger-wilco-coordinator": "./src/bin/coordinator.ts",
    "roger-wilco-host": "./src/bin/host.ts"
  },
  "engines": { "node": ">=26.11.1" },
  "keywords": ["pi-package"],
  "pi": { "extensions": ["./src/pi/index.ts"] },
  "scripts": {
    "test": "node --test test/**/*.test.mjs test/**/*.test.ts",
    "test:contract": "node --test test/protocol/*.test.mjs test/protocol/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "coordinator": "node src/bin/coordinator.ts",
    "host": "node src/bin/host.ts",
    "setup:sdk": "node scripts/link-sdk.mjs",
    "prepack": "node scripts/pack-lock.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typebox": "1.3.27",
    "typescript": "6.0.3"
  }
}
