#!/usr/bin/env bash
# The Pi shim's own check: its unit tests that need no `pi` binary.
# legacy/pi/acceptance (pi-shim, wake, independence) drives a real Pi.
set -euo pipefail
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then echo "usage: $0 (run shim unit tests)"; exit 0; fi
[[ $# == 0 ]] || { echo "usage: $0" >&2; exit 2; }
cd "$(dirname "${BASH_SOURCE[0]}")"
exec node --test test/*.test.ts
