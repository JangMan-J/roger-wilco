#!/usr/bin/env bash
# Install the Pi shim for this user, on top of an installed roger core.
#
#   legacy/pi/install              copy the shim from this checkout to
#                                 ~/.local/share/roger-shims/pi/ and list that
#                                 directory once in the `packages` array of Pi's
#                                 settings.json (${PI_CODING_AGENT_DIR:-~/.pi/agent})
#   legacy/pi/install --uninstall  remove that entry and that directory; Stores stay
#
# Idempotent: rerunning replaces the copy and leaves one entry. Touches nothing
# outside its own directory and its own entry in Pi's settings. See README.md.
set -euo pipefail

src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
dir="$HOME/.local/share/roger-shims/pi"
settings="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}/settings.json"
files=(roger.ts roger-adapter.ts roger-command.ts roger-target.ts roger-env.ts package.json)

usage() { echo "usage: $0 [--uninstall] (settings: \${PI_CODING_AGENT_DIR:-\$HOME/.pi/agent}/settings.json)"; }
if [[ "${1:-}" == --help || "${1:-}" == -h ]]; then usage; exit 0; fi
[[ $# -le 1 && ( "${1:-}" == "" || "$1" == --uninstall ) ]] || { usage >&2; exit 2; }

command -v node >/dev/null || { echo "node not found on PATH" >&2; exit 1; }

# packages <add|remove>: edit the packages array in place, keeping the rest.
packages() {
  node - "$1" "$settings" "$dir" <<'EOF'
const fs = require("node:fs");
const path = require("node:path");
const [op, file, dir] = process.argv.slice(2);
let s = {};
try {
  s = JSON.parse(fs.readFileSync(file, "utf8"));
} catch (e) {
  if (e.code !== "ENOENT") throw e;
  if (op === "remove") process.exit(0);
}
const ours = (p) => (typeof p === "string" ? p : p?.source) === dir;
const all = s.packages ?? [];
if (op === "add" && all.some(ours)) process.exit(0); // already listed; keep any filters on it
s.packages = op === "add" ? [...all, dir] : all.filter((p) => !ours(p));
fs.mkdirSync(path.dirname(file), { recursive: true });
fs.writeFileSync(`${file}.tmp`, JSON.stringify(s, null, 2) + "\n");
fs.renameSync(`${file}.tmp`, file);
EOF
}

case "${1:-}" in
"")
  for f in "${files[@]}"; do [[ -f "$src/$f" ]] || { echo "missing $src/$f" >&2; exit 1; }; done
  mkdir -p "$dir"
  for f in "${files[@]}"; do install -m 0644 "$src/$f" "$dir/$f"; done
  packages add
  echo "installed $dir and listed it in $settings"
  ;;
--uninstall)
  packages remove
  rm -rf "$dir"
  echo "removed $dir and its entry in $settings; Stores under \${XDG_STATE_HOME:-~/.local/state}/roger-shims/pi are kept"
  ;;
esac
